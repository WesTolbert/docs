import * as React from "react"

import { cn } from "@/lib/utils"

type AttachmentOrientation = "horizontal" | "vertical"

type AttachmentProps = React.HTMLAttributes<HTMLDivElement> & {
  state?: "default" | "uploading"
  orientation?: AttachmentOrientation
}

const AttachmentContext = React.createContext<{ state?: "default" | "uploading" }>({ state: "default" })

const Attachment = React.forwardRef<HTMLDivElement, AttachmentProps>(
  ({ className, state = "default", orientation = "horizontal", ...props }, ref) => (
    <AttachmentContext.Provider value={{ state }}>
      <div
        ref={ref}
        data-state={state}
        className={cn(
          "flex w-full items-center gap-3 rounded-xl border border-border/70 bg-background/70 p-2 text-left shadow-sm transition-colors",
          orientation === "vertical" && "flex-col items-stretch",
          state === "uploading" && "border-violet-500/50 bg-violet-500/5",
          className
        )}
        {...props}
      />
    </AttachmentContext.Provider>
  )
)
Attachment.displayName = "Attachment"

const AttachmentGroup = React.forwardRef<HTMLDivElement, React.HTMLAttributes<HTMLDivElement>>(
  ({ className, ...props }, ref) => (
    <div ref={ref} className={cn("flex flex-col gap-3", className)} {...props} />
  )
)
AttachmentGroup.displayName = "AttachmentGroup"

const AttachmentMedia = React.forwardRef<
  HTMLDivElement,
  React.HTMLAttributes<HTMLDivElement> & { variant?: "default" | "image" }
>(({ className, variant = "default", children, ...props }, ref) => {
  return (
    <div
      ref={ref}
      className={cn(
        "flex shrink-0 items-center justify-center overflow-hidden rounded-lg border border-border/60 bg-muted/70 text-muted-foreground",
        variant === "image" ? "h-16 w-full overflow-hidden rounded-lg" : "h-11 w-11",
        className
      )}
      {...props}
    >
      {children}
    </div>
  )
})
AttachmentMedia.displayName = "AttachmentMedia"

const AttachmentContent = React.forwardRef<HTMLDivElement, React.HTMLAttributes<HTMLDivElement>>(
  ({ className, ...props }, ref) => (
    <div ref={ref} className={cn("min-w-0 flex-1", className)} {...props} />
  )
)
AttachmentContent.displayName = "AttachmentContent"

const AttachmentTitle = React.forwardRef<HTMLDivElement, React.HTMLAttributes<HTMLDivElement>>(
  ({ className, ...props }, ref) => (
    <div ref={ref} className={cn("truncate text-sm font-medium text-foreground", className)} {...props} />
  )
)
AttachmentTitle.displayName = "AttachmentTitle"

const AttachmentDescription = React.forwardRef<HTMLDivElement, React.HTMLAttributes<HTMLDivElement>>(
  ({ className, ...props }, ref) => (
    <div ref={ref} className={cn("truncate text-xs text-muted-foreground", className)} {...props} />
  )
)
AttachmentDescription.displayName = "AttachmentDescription"

const AttachmentActions = React.forwardRef<HTMLDivElement, React.HTMLAttributes<HTMLDivElement>>(
  ({ className, ...props }, ref) => <div ref={ref} className={cn("ml-auto flex items-center gap-1", className)} {...props} />
)
AttachmentActions.displayName = "AttachmentActions"

const AttachmentAction = React.forwardRef<HTMLButtonElement, React.ButtonHTMLAttributes<HTMLButtonElement>>(
  ({ className, type = "button", ...props }, ref) => (
    <button
      ref={ref}
      type={type}
      className={cn(
        "inline-flex h-8 w-8 items-center justify-center rounded-md border border-border/60 bg-background/50 text-muted-foreground transition hover:bg-muted hover:text-foreground",
        className
      )}
      {...props}
    />
  )
)
AttachmentAction.displayName = "AttachmentAction"

export {
  Attachment,
  AttachmentAction,
  AttachmentActions,
  AttachmentContent,
  AttachmentDescription,
  AttachmentGroup,
  AttachmentMedia,
  AttachmentTitle,
}
